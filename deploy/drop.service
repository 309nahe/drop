[Unit]
Description=drop (in-memory clipboard and file drop, private network only)
After=network.target

[Service]
User=CHANGEME
ExecStart=/opt/drop/drop
Environment=BIND=127.0.0.1:8451
Restart=on-failure
RestartSec=3
StartLimitIntervalSec=300
StartLimitBurst=20
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=400M
CPUQuota=200%

[Install]
WantedBy=multi-user.target
